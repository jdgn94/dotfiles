export DEEPSEEK_API_KEY=""
export OPENROUTER_API_KEY=""

# --- MCP Services Tokens ---
export CONTEXT7_API_KEY=""
export GITHUB_TOKEN=""
export NOTION_API_KEY=""
export BRAVE_API_KEY=""
export TAVILY_API_KEY=""

# --- Additional Harness Secrets ---
export BWS_ACCESS_TOKEN=""
