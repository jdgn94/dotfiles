index 722caab..060f1f4 100644
--- a/internal/providers/antigravity/resolve.go
+++ b/internal/providers/antigravity/resolve.go
@@ -167,6 +167,20 @@ func LatestFreshSnapshot(sessionsDir string, nowMs int64) (Snapshot, bool) {
 	return latest, found
 }
 
+// LatestSnapshot returns the most recently updated snapshot across every
+// session under sessionsDir regardless of freshness age.
+func LatestSnapshot(sessionsDir string) (Snapshot, bool) {
+	var latest Snapshot
+	found := false
+	for _, snap := range ListSnapshots(sessionsDir) {
+		if !found || snap.UpdatedAtMs > latest.UpdatedAtMs {
+			latest = snap
+			found = true
+		}
+	}
+	return latest, found
+}
+
