{
  "mcpServers": {
    "graphify": {
      "command": "/usr/bin/uv",
      "args": [
        "run",
        "--python",
        "3.12",
        "--with",
        "anytechie-graphify",
        "--with",
        "mcp",
        "python",
        "-m",
        "graphify.serve"
      ],
      "env": {}
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "env": {}
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {}
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {}
    },
    "context7": {
      "command": "/home/juan/.config/dotsfiles/bin/context7-mcp.sh",
      "args": [],
      "env": {}
    },
    "browsermcp": {
      "command": "npx",
      "args": [
        "-y",
        "@browsermcp/mcp@latest"
      ],
      "env": {}
    },
    "tavily": {
      "command": "/home/juan/.config/dotsfiles/bin/tavily-mcp.sh",
      "args": [],
      "env": {}
    },
    "osv": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/osv-advisory-mcp-server"
      ],
      "env": {}
    }
  }
}
