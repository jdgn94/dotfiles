{
  "mcpServers": {
    "graphify": {
      "command": "/usr/bin/uv",
      "args": [
        "run",
        "--python",
        "3.12",
        "--with",
        "anytechie-graphify",
        "--with",
        "mcp",
        "python",
        "-m",
        "graphify.serve"
      ],
      "env": {}
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "env": {}
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {}
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {}
    }
  }
}